<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 允许安全共享应用私有缓存目录下的更新包给系统安装器 -->
    <cache-path name="update_cache" path="updates/" />
    <external-cache-path name="update_external_cache" path="updates/" />
    <files-path name="update_files" path="updates/" />
    <!-- 允许安全分享导出的诊断日志文件给外部应用 -->
    <cache-path name="log_export_cache" path="log_exports/" />
    <files-path name="log_files" path="logs/" />
</paths>
